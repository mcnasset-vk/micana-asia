# Copy to .env.local and fill in. This file is committed; .env.local is not.

# --- Supabase ---------------------------------------------------------------
# Both values are safe for the browser — row level security is what protects
# the data, not the key. Never put the service role key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Business figures -------------------------------------------------------
# Every commercially sensitive number lives here rather than in source: contract
# values, revenue targets, staff quotas and contractor rates. Several are
# individual compensation terms covered by confidentiality clauses, so they must
# never be committed — not in code, not in a default, not in a comment.
#
# All are read in lib/config.ts. An unset value falls back to 0, which renders
# honest zeroes rather than NaN, so a dashboard showing RM 0 everywhere means
# the environment is incomplete.

# Capital raise. The deadline is as disclosive as the target — together they
# describe the whole raise — so it lives here too. Format: YYYY-MM-DD.

# Tenant payment details — shown on the tenant's own page so they know where
# to send rent. These reach the browser bundle, so use the account you would
# print on an invoice. Leave blank to show "contact the office" instead.
NEXT_PUBLIC_PAY_TO_NAME=
NEXT_PUBLIC_PAY_BANK=
NEXT_PUBLIC_PAY_ACCOUNT=
NEXT_PUBLIC_PAY_CONTACT=

# --- Online payments (server only) ------------------------------------------
# None of these is NEXT_PUBLIC_ and none may ever become so: each is read on
# the server alone (lib/payments/payex/, lib/supabase/service.ts). Set them in
# the hosting environment as encrypted secrets, and in .env.local for a dev
# server. Leave PAYEX_USERNAME or PAYEX_SECRET blank and the tenant screens
# offer bank transfer only.
#
# PAYEX_USERNAME       The merchant email registered with Payex.
# PAYEX_SECRET         Settings page of the Payex portal. Production and
#                      sandbox secrets are different keys and are not
#                      interchangeable — using one against the other fails.
# PAYEX_BASE_URL       https://api.payex.io for production, or
#                      https://sandbox-payexapi.azurewebsites.net to test.
#                      Defaults to production when unset.
# PAYEX_COLLECTION_ID  Only if the account uses collections. Omitted from the
#                      request entirely when blank.
# SUPABASE_SECRET_KEY  The project's secret (service-role) key. Used only to
#                      write what a gateway reported; never the publishable
#                      key, never in the browser.
PAYEX_USERNAME=
PAYEX_SECRET=
PAYEX_BASE_URL=
PAYEX_COLLECTION_ID=
#
# PAYEX_PAID_STATUSES    Comma-separated Payex transaction statuses that mean
#                        the money is ours, e.g. "Successful". Matched
#                        case-insensitively. LEAVE BLANK until the value has
#                        been SEEN — on a real transaction, or in Payex's
#                        reference table. A wrong value here marks rent paid
#                        for money that never arrived and nothing downstream
#                        contradicts it; a missing one only leaves a payment
#                        visible and unsettled, which a person can fix.
#                        Until it is set, no online payment settles.
# PAYEX_FAILED_STATUSES  The same, for statuses that mean the attempt is over
#                        and unpaid. "failed" is built in already.
PAYEX_PAID_STATUSES=
PAYEX_FAILED_STATUSES=
SUPABASE_SECRET_KEY=

