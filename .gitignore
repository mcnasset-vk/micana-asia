# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real values.
# .env.example is the documented template and IS committed.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NOTE: `vercel link` appends its own `.vercel` and `.env*` rules here.
# Both are already covered above, and a trailing `.env*` would override the
# `!.env.example` negation (git applies the last matching rule), so the
# duplicates are removed deliberately. If you re-run `vercel link`, check
# this file again.

# Personal Claude Code settings (trust decisions, local overrides)
.claude/settings.local.json
